# Local PostgreSQL started by docker compose.
DATABASE_URL=postgresql://convoflow:convoflow_dev_password@127.0.0.1:5432/convoflow

# Set by authentication after the first workspace is created. Do not use a shared
# workspace ID in production request handling.
CONVOFLOW_DEMO_WORKSPACE_ID=

# WhatsApp Cloud API. Leave blank until the Meta app is ready.
META_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
META_WABA_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_GRAPH_API_VERSION=
